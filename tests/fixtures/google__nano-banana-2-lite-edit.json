    "description": "[Core Function] Nano Banana 2 Lite Edit (Gemini 3.1 Flash Lite Image) is the lightweight, cost-efficient image editing model of the Nano Banana 2 family; it transforms one or more input images per a text instruction. [Strengths] It performs fast, low-cost instruction-based editing across up to 14 input images. [Best For] Highly recommended for: high-volume edits, quick style transforms, and batch background or attribute changes where cost and throughput matter. [Limitations] Do NOT use this model when you need the highest edit fidelity or richest detail; use Nano Banana 2 Edit or Nano Banana Pro Edit instead. [Routing] Choose the Lite variant for cost- and throughput-sensitive edits; step up to Nano Banana 2 Edit for higher quality.",
    "operationId": "nanoBananaLiteEditI2IAsync",
    "requestBody": {
      "content": {
        "application/json": {
          "examples": {
            "image_edit": {
              "summary": "Image editing",
              "value": {
                "image": [
                  "https://example.com/image.jpg"
                ],
                "prompt": "Transform this into a watercolor painting"
              }
            },
            "with_options": {
              "summary": "With aspect ratio and resolution",
              "value": {
                "aspectRatio": "16:9",
                "image": [
                  "https://example.com/image.jpg"
                ],
                "imageSize": "1K",
                "prompt": "Make it a bold poster"
              }
            }
          },
          "schema": {
            "description": "At least one of image or video must be provided. Both may be provided together.",
            "properties": {
              "aspectRatio": {
                "default": "1:1",
                "description": "Output image aspect ratio",
                "enum": [
                  "1:1",
                  "1:4",
                  "1:8",
                  "2:3",
                  "3:2",
                  "3:4",
                  "4:1",
                  "4:3",
                  "4:5",
                  "5:4",
                  "8:1",
                  "9:16",
                  "16:9",
                  "21:9"
                ],
                "example": "16:9",
                "type": "string"
              },
              "image": {
                "description": "Input image URLs. At least one of image or video must be provided. Supports up to 14 images, or up to 10 images when video is also provided.",
                "example": [
                  "https://example.com/image.jpg"
                ],
                "items": {
                  "description": "Image URL (e.g. `https://example.com/image.jpg`).",
                  "type": "string"
                },
                "maxItems": 14,
                "minItems": 1,
                "type": "array"
              },
              "imageSize": {
                "description": "Output image resolution (Flash Lite supports 1K only)",
                "enum": [
                  "1K"
                ],
                "example": "1K",
                "type": "string"
              },
              "prompt": {
                "description": "Editing instruction describing the desired transformation",
                "example": "Transform this into a watercolor painting",
                "minLength": 1,
                "type": "string"
              },
              "video": {
                "description": "Input video URL. At least one of image or video must be provided. Must be a publicly accessible HTTPS URL without cookies, authentication, or custom headers. Maximum file size: 15 MB.",
                "example": "https://example.com/video.mp4",
                "type": "string"
              },
              "videoMimeType": {
                "description": "MIME type of the input video. Requires video.",
                "enum": [
                  "video/mp4",
                  "video/mpeg",
                  "video/mpg",
                  "video/mpegps",
                  "video/mov",
                  "video/avi",
                  "video/wmv",
                  "video/flv"
                ],
                "example": "video/mp4",
                "type": "string"
              }
            },
            "required": [
              "prompt"
            ],
            "type": "object"
          }
        }
      },
      "required": true
