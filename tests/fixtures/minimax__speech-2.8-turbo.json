                "model_id": "minimax/speech-2.8-turbo",
                "status": "pending",
                "task_id": "task-speech-28-turbo-001"
              },
              "message": "success"
            },
            "schema": {
              "description": "Response object for asynchronous task submission.",
              "properties": {
                "code": {
                  "description": "Response code, 0 indicates success",
                  "example": 0,
