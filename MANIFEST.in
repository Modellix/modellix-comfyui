include LICENSE README.md requirements.txt
include __init__.py
recursive-include web *.js *.css
recursive-include examples *.json *.md *.png *.wav *.mp4
recursive-include example_workflows *.json
recursive-include docs/images *.webp
exclude AGENTS.md AGENGTS.md
exclude .env .env.*
exclude comfy-registry-token.txt
global-exclude *.key *.pem *apikey*.txt *token*.txt *.log *.pyc
prune .agents
prune .docs
prune .venv
prune .ci-venv
prune .cache
prune outputs
